# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
# The iCIMS browser-impersonation fetcher's own venv (curl_cffi).
.venv-icims/

# OS / editor
.DS_Store
*.swp

# The candidate's own inputs: candidate_profile.yaml, the resume PDFs, the transcript,
# and the outreach voice and samples. Personal data -- never commit.
data/candidate/

# Generated local state: the dedupe ledger, cached postings and descriptions, briefs,
# the outreach log, board health, the sweep cache, logs, and resume backups. Some of it
# is personal (outreach.jsonl holds contacts).
data/state/

# The client's built bundles (client/dist/) are committed: the production server serves
# client/ verbatim and has no node on the box. The dev dependency tree is not.
client/node_modules/

# Any PDF here is a personal document (resume, transcript).
*.pdf
